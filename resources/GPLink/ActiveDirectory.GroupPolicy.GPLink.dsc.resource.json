{
    "$schema": "https://aka.ms/dsc/schemas/v3/bundled/resource/manifest.json",
    "type": "ActiveDirectory.GroupPolicy/GPLink",
    "description": "Manages Group Policy Object links to Active Directory sites, domains, and OUs using the Windows GroupPolicy PowerShell module.",
    "version": "0.1.0",
    "tags": ["Windows", "ActiveDirectory", "GroupPolicy"],
    "get": {
        "executable": "powershell",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "ActiveDirectory.GroupPolicy.GPLink.ps1",
            "Get"
        ],
        "input": "stdin"
    },
    "set": {
        "executable": "powershell",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "ActiveDirectory.GroupPolicy.GPLink.ps1",
            "Set"
        ],
        "input": "stdin",
        "implementsPretest": false,
        "return": "state",
        "requireSecurityContext": "elevated"
    },
    "test": {
        "executable": "powershell",
        "args": [
            "-NoLogo",
            "-NonInteractive",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-File",
            "ActiveDirectory.GroupPolicy.GPLink.ps1",
            "Test"
        ],
        "input": "stdin",
        "return": "state"
    },
    "exitCodes": {
        "0": "Success",
        "1": "Invalid arguments or JSON input",
        "2": "GroupPolicy PowerShell module not available",
        "3": "Group Policy link operation failed"
    },
    "schema": {
        "embedded": {
            "$schema": "https://json-schema.org/draft/2020-12/schema",
            "type": "object",
            "required": ["gpoName", "target"],
            "additionalProperties": false,
            "properties": {
                "gpoName": {
                    "type": "string",
                    "description": "Display name of the GPO to link. Must be unique in the domain."
                },
                "target": {
                    "type": "string",
                    "description": "LDAP distinguished name of the site, domain, or OU to link the GPO to. Example: 'ou=Marketing,dc=contoso,dc=com'."
                },
                "linkEnabled": {
                    "type": ["string", "null"],
                    "enum": ["Yes", "No", "Unspecified", null],
                    "description": "Whether the GPO link is enabled. Defaults to Yes when creating a new link."
                },
                "enforced": {
                    "type": ["string", "null"],
                    "enum": ["Yes", "No", "Unspecified", null],
                    "description": "Whether the GPO link is enforced, preventing lower-level containers from blocking it."
                },
                "order": {
                    "type": ["integer", "null"],
                    "minimum": 1,
                    "description": "Link order (precedence) for the GPO at the target container. Lower number = higher precedence."
                },
                "domain": {
                    "type": ["string", "null"],
                    "description": "FQDN of the domain containing the GPO. Defaults to the current user's domain."
                },
                "server": {
                    "type": ["string", "null"],
                    "description": "FQDN or host name of the domain controller to contact. Defaults to the PDC emulator."
                },
                "gpoId": {
                    "type": ["string", "null"],
                    "readOnly": true,
                    "description": "GUID of the linked GPO (populated by get/set)."
                },
                "ensure": {
                    "type": ["string", "null"],
                    "enum": ["Present", "Absent", null],
                    "description": "'Present' ensures the link exists; 'Absent' removes it. Defaults to 'Present'.",
                    "default": "Present"
                },
                "_exist": {
                    "type": ["boolean", "null"],
                    "description": "Whether the link should exist. Deprecated — use 'ensure' instead. Defaults to true.",
                    "default": true
                },
                "_inDesiredState": {
                    "type": ["boolean", "null"],
                    "readOnly": true,
                    "description": "Indicates whether the current link state matches the desired state (populated by test/set)."
                }
            }
        }
    }
}
